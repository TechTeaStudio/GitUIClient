<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.CloneDialog"
        Title="Clone repository"
        Width="540" Height="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource HyperionSurfaceCardBrush}" CornerRadius="0">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">

      <!-- Header -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="CloudDownloadOutline" Width="20" Height="20"
                         Foreground="{DynamicResource HyperionPrimaryBrush}" />
        <TextBlock Text="Clone repository" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- URL -->
      <TextBox Grid.Row="1"
               Name="UrlBox"
               Watermark="Clone URL  (https://github.com/owner/repo.git)" />

      <!-- Destination -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Top">
        <TextBox Grid.Column="0"
                 Name="PathBox"
                 Watermark="Destination folder  (e.g. C:\repos\my-repo)" />
        <Button Grid.Column="1"
                Classes="icon Flat"
                ToolTip.Tip="Browse for destination folder…"
                Click="PickFolder_Click">
          <mi:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
        </Button>
      </Grid>

      <!-- Buttons -->
      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="Outline action" Click="Cancel_Click">
          <TextBlock Text="CANCEL" />
        </Button>
        <Button Classes="Flat action" Click="Clone_Click" IsDefault="True">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="CloudDownloadOutline" Width="14" Height="14" />
            <TextBlock Text="CLONE" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
