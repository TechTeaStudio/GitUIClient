<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.DiffViewerWindow"
        Title="Diff viewer"
        Width="1100" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource HyperionSurfaceCardBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #44000000" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource HyperionTextMedium}" />
    </Style>
  </Window.Styles>

  <Grid Margin="10" RowDefinitions="Auto,*" RowSpacing="8">

    <!-- Header -->
    <Border Grid.Row="0" Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="VectorDifference" Width="18" Height="18"
                         Foreground="{DynamicResource HyperionPrimaryBrush}" />
        <TextBlock Text="Diff viewer" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Name="HeaderSubtitle"
                   Classes="muted" FontSize="11"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Body: left file list + right unified diff -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="8">
      <Border Grid.Column="0" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="10,8,10,4">
            <mi:MaterialIcon Kind="FileMultipleOutline" Width="12" Height="12"
                             Foreground="{DynamicResource HyperionTextHigh}" />
            <TextBlock Text="CHANGED FILES" Classes="section" />
          </StackPanel>
          <ListBox Grid.Row="1"
                   Name="FileList"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectionChanged="FileList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="28" VerticalAlignment="Center">
                  <Border Grid.Column="0"
                          Width="16" Height="16"
                          Margin="0,0,6,0"
                          CornerRadius="3"
                          Background="{Binding KindBrush}"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding KindGlyph}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="{Binding Path}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"
                             FontSize="11" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding AddedText}"
                             Foreground="{DynamicResource HyperionSuccessBrush}"
                             FontFamily="Consolas"
                             FontSize="10"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3"
                             Text="{Binding DeletedText}"
                             Foreground="{DynamicResource HyperionDangerBrush}"
                             FontFamily="Consolas"
                             FontSize="10"
                             Margin="4,0,10,0"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="MinHeight" Value="28" />
              </Style>
            </ListBox.Styles>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="10,8,10,4">
            <mi:MaterialIcon Kind="CodeBraces" Width="12" Height="12"
                             Foreground="{DynamicResource HyperionTextHigh}" />
            <TextBlock Text="UNIFIED DIFF" Classes="section" />
            <TextBlock Name="FileHeader"
                       Classes="muted"
                       FontFamily="Consolas"
                       FontSize="11"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>

          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        Padding="0,4,4,8">
            <ItemsControl Name="DiffLines">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="40,40,*"
                        Background="{Binding RowBackground}">
                    <TextBlock Grid.Column="0"
                               Text="{Binding OldNumberText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource HyperionTextLow}"
                               TextAlignment="Right"
                               Padding="0,0,6,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding NewNumberText}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource HyperionTextLow}"
                               TextAlignment="Right"
                               Padding="0,0,6,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayContent}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{Binding Foreground}"
                               TextWrapping="NoWrap"
                               Padding="4,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
