<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.TreeBrowserWindow"
        Title="Tree browser"
        Width="1080" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource HyperionSurfaceCardBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #44000000" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource HyperionTextMedium}" />
    </Style>
  </Window.Styles>

  <Grid Margin="10" RowDefinitions="Auto,*" RowSpacing="8">

    <!-- Header -->
    <Border Grid.Row="0" Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="FileTree" Width="18" Height="18"
                         Foreground="{DynamicResource HyperionPrimaryBrush}" />
        <TextBlock Text="Tree browser" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Name="CommitLabel"
                   Classes="muted" FontFamily="Consolas" FontSize="11"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="8">
      <Border Grid.Column="0" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="10,8,10,4">
            <mi:MaterialIcon Kind="FolderOutline" Width="12" Height="12"
                             Foreground="{DynamicResource HyperionTextHigh}" />
            <TextBlock Text="TREE" Classes="section" />
          </StackPanel>
          <TreeView Grid.Row="1"
                    Name="Tree"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="Tree_SelectionChanged">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <mi:MaterialIcon Kind="{Binding IconKind}"
                                   Width="14" Height="14"
                                   Foreground="{Binding IconBrush}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11" />
                  <TextBlock Text="{Binding SizeLabel}"
                             Foreground="{DynamicResource HyperionTextLow}"
                             FontSize="10"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="10,8,10,4">
            <mi:MaterialIcon Kind="FileDocumentOutline" Width="12" Height="12"
                             Foreground="{DynamicResource HyperionTextHigh}" />
            <TextBlock Text="CONTENTS" Classes="section" />
            <TextBlock Name="ContentPath"
                       Classes="muted" FontFamily="Consolas" FontSize="11"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="1">
            <TextBox Name="ContentBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="10,0,10,10"
                     IsVisible="False" />
            <StackPanel Name="BinaryBanner"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="False">
              <mi:MaterialIcon Kind="FileLock" Width="36" Height="36"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource HyperionTextMedium}" />
              <TextBlock Text="Binary file — preview unavailable"
                         FontSize="13" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Name="BinarySize"
                         Classes="muted" FontSize="11"
                         HorizontalAlignment="Center" />
            </StackPanel>
            <TextBlock Name="EmptyBanner"
                       Text="Select a file to preview its contents at this commit."
                       Foreground="{DynamicResource HyperionTextMedium}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       IsVisible="True" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
