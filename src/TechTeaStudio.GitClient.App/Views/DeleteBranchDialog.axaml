<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.DeleteBranchDialog"
        Title="Delete branch"
        Width="480" Height="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="Button.action">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource HyperionSurfaceCardBrush}" CornerRadius="0">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">

      <!-- Header -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="DeleteOutline" Width="20" Height="20"
                         Foreground="{DynamicResource HyperionTertiaryBrush}" />
        <TextBlock Text="Delete branch" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- Branch name -->
      <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock Text="Branch" Foreground="{DynamicResource HyperionTextMedium}" FontSize="10" />
        <TextBlock Name="NameLabel" FontSize="13" FontWeight="SemiBold" />
      </StackPanel>

      <!-- Force checkbox -->
      <CheckBox Grid.Row="2"
                Name="ForceBox"
                Content="Branch not merged — force delete" />

      <Border Grid.Row="3" />

      <!-- Buttons -->
      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="Outline action" Click="Cancel_Click">
          <TextBlock Text="CANCEL" />
        </Button>
        <Button Classes="Flat action" Click="Delete_Click" IsDefault="True">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" />
            <TextBlock Text="DELETE" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
