<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.CreateBranchDialog"
        Title="Create branch"
        Width="500" Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource HyperionSurfaceCardBrush}" CornerRadius="0">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">

      <!-- Header -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="SourceBranchPlus" Width="20" Height="20"
                         Foreground="{DynamicResource HyperionPrimaryBrush}" />
        <TextBlock Text="Create branch" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- Name -->
      <TextBox Grid.Row="1"
               Name="NameBox"
               Watermark="Branch name  (e.g. feature/awesome-thing)" />

      <!-- Start point -->
      <TextBox Grid.Row="2"
               Name="StartPointBox"
               Watermark="Start-point SHA  (optional — leave empty to branch from HEAD)" />

      <!-- Checkout option -->
      <CheckBox Grid.Row="3"
                Name="CheckoutBox"
                Content="Check out the new branch immediately" />

      <Border Grid.Row="4" />

      <!-- Buttons -->
      <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="Outline action" Click="Cancel_Click">
          <TextBlock Text="CANCEL" />
        </Button>
        <Button Classes="Flat action" Click="Create_Click" IsDefault="True">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="SourceBranchPlus" Width="14" Height="14" />
            <TextBlock Text="CREATE" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
