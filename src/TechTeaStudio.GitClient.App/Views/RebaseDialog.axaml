<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.RebaseDialog"
        Title="Rebase current branch"
        Width="520" Height="320"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="Button.action">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource HyperionSurfaceCardBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="SourceFork" Width="20" Height="20"
                         Foreground="{DynamicResource HyperionPrimaryBrush}" />
        <TextBlock Text="Rebase current branch onto upstream" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Row="1" Text="Upstream branch" FontSize="10" FontWeight="SemiBold"
                 Foreground="{DynamicResource HyperionTextMedium}" />

      <ComboBox Grid.Row="2"
                Name="UpstreamBranchBox"
                HorizontalAlignment="Stretch"
                MinHeight="36">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <mi:MaterialIcon Kind="SourceBranch" Width="12" Height="12"
                               Foreground="{DynamicResource HyperionTertiaryBrush}" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="3"
                 Text="Rebase replays your branch's commits on top of the chosen upstream. Conflicts will pause the operation."
                 Foreground="{DynamicResource HyperionTextMedium}"
                 FontSize="11"
                 TextWrapping="Wrap" />

      <Border Grid.Row="4" />

      <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <Button Grid.Column="0" Classes="Outline action"
                Name="ContinueButton"
                Click="Continue_Click"
                ToolTip.Tip="Continue an in-progress rebase">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <mi:MaterialIcon Kind="PlayOutline" Width="14" Height="14" />
            <TextBlock Text="CONTINUE" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="1" Classes="Outline action" Margin="6,0,0,0"
                Name="SkipButton"
                Click="Skip_Click"
                ToolTip.Tip="Skip the current rebase step">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <mi:MaterialIcon Kind="SkipNextOutline" Width="14" Height="14" />
            <TextBlock Text="SKIP" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="2" Classes="Outline action" Margin="6,0,0,0"
                Name="AbortButton"
                Click="Abort_Click"
                ToolTip.Tip="Abort the in-progress rebase"
                Foreground="{DynamicResource HyperionDangerBrush}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <mi:MaterialIcon Kind="CancelOutline" Width="14" Height="14" />
            <TextBlock Text="ABORT" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="4" Classes="Outline action" Click="Cancel_Click">
          <TextBlock Text="CANCEL" />
        </Button>
        <Button Grid.Column="5" Classes="Flat action" Margin="6,0,0,0"
                Click="Start_Click" IsDefault="True">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="SourceFork" Width="14" Height="14" />
            <TextBlock Text="START" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
