<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.StashSaveDialog"
        Title="Stash changes"
        Width="480" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource HyperionSurfaceCardBrush}" CornerRadius="0">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="ContentSave" Width="20" Height="20"
                         Foreground="{DynamicResource HyperionPrimaryBrush}" />
        <TextBlock Text="Stash changes" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBox Grid.Row="1"
               Name="MessageBox"
               Watermark="Stash message  (optional)" />

      <CheckBox Grid.Row="2"
                Name="IncludeUntrackedBox"
                Content="Include untracked files"
                Foreground="{DynamicResource HyperionTextHigh}" />

      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="Outline action" Click="Cancel_Click">
          <TextBlock Text="CANCEL" />
        </Button>
        <Button Classes="Flat action" Click="Save_Click" IsDefault="True">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="ContentSave" Width="14" Height="14" />
            <TextBlock Text="STASH" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
