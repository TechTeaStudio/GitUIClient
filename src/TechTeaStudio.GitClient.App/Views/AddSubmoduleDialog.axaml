<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.AddSubmoduleDialog"
        Title="Add submodule"
        Width="520" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Border Padding="18" Background="{DynamicResource HyperionSurfaceCardBrush}" CornerRadius="0">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="SourceBranchPlus" Width="20" Height="20"
                         Foreground="{DynamicResource HyperionPrimaryBrush}" />
        <TextBlock Text="Add submodule" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </StackPanel>

      <TextBox Grid.Row="1"
               Name="UrlBox"
               Watermark="Submodule clone URL  (https://github.com/owner/repo.git)" />

      <TextBox Grid.Row="2"
               Name="PathBox"
               Watermark="Path inside parent repo  (e.g. vendor/libfoo)" />

      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="Outline action" Click="Cancel_Click">
          <TextBlock Text="CANCEL" />
        </Button>
        <Button Classes="Flat action" Click="Confirm_Click" IsDefault="True">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <mi:MaterialIcon Kind="Plus" Width="14" Height="14" />
            <TextBlock Text="ADD" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
