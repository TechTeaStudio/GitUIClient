<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TechTeaStudio.GitClient.App.Views.BlameWindow"
        Title="Blame"
        Width="1140" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource HyperionSurfaceBaseBrush}"
        Foreground="{DynamicResource HyperionTextHigh}"
        FontSize="12">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource HyperionSurfaceCardBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #44000000" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource HyperionTextMedium}" />
    </Style>
  </Window.Styles>

  <Grid Margin="10" RowDefinitions="Auto,*" RowSpacing="8">

    <Border Grid.Row="0" Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <mi:MaterialIcon Kind="AccountGroupOutline" Width="18" Height="18"
                         Foreground="{DynamicResource HyperionPrimaryBrush}" />
        <TextBlock Text="Blame" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <TextBlock Name="FileLabel"
                   Classes="muted" FontFamily="Consolas" FontSize="11"
                   VerticalAlignment="Center" />
        <TextBlock Name="CommitLabel"
                   Classes="muted" FontFamily="Consolas" FontSize="11"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="card" Padding="0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="BlameLines">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="90,28,140,90,46,*"
                    Background="{Binding RowBackground}"
                    Height="22">
                <Button Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,0,0,0"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Command="{Binding CopyShaCommand}"
                        ToolTip.Tip="Copy full SHA">
                  <TextBlock Text="{Binding ShortSha}"
                             FontFamily="Consolas"
                             FontSize="11"
                             Foreground="{DynamicResource HyperionTertiaryBrush}" />
                </Button>
                <Border Grid.Column="1"
                        Width="20" Height="20"
                        CornerRadius="10"
                        Background="{Binding InitialsBrush}"
                        VerticalAlignment="Center">
                  <TextBlock Text="{Binding Initials}"
                             FontSize="10"
                             FontWeight="Bold"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="2"
                           Text="{Binding Author}"
                           FontSize="11"
                           Foreground="{DynamicResource HyperionTextHigh}"
                           TextTrimming="CharacterEllipsis"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{Binding DateText}"
                           FontSize="10"
                           Foreground="{DynamicResource HyperionTextMedium}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Text="{Binding LineNumber}"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{DynamicResource HyperionTextLow}"
                           TextAlignment="Right"
                           Padding="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="5"
                           Text="{Binding Content}"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="{DynamicResource HyperionTextHigh}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
