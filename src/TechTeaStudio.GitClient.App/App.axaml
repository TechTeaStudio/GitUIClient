<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="TechTeaStudio.GitClient.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Single source of truth for the palette. Themes/HyperionTheme.axaml holds
           every Hyperion.*, Glass.* and Chrome.* token for both Dark and Light. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://TechTeaStudio.GitClient.App/Themes/HyperionTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <themes:MaterialTheme BaseTheme="Inherit" PrimaryColor="Purple" SecondaryColor="Cyan" />
    <icons:MaterialIconStyles />
    <StyleInclude Source="avares://TechTeaStudio.GitClient.App/Themes/Spinner.axaml" />

    <!-- Override Material.Avalonia named brushes to use our theme-aware Hyperion palette. -->
    <Style>
      <Style.Resources>
        <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{DynamicResource HyperionPrimary600}" />
        <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="White" />
        <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{DynamicResource HyperionPrimary}" />
        <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="White" />
        <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="{DynamicResource HyperionPrimary700}" />
        <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="White" />

        <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="{DynamicResource HyperionTertiary}" />
        <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="Black" />
        <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{DynamicResource HyperionTertiary}" />
        <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="Black" />
        <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="{DynamicResource HyperionTertiaryDark}" />
        <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="White" />

        <SolidColorBrush x:Key="MaterialPaperBrush" Color="{DynamicResource HyperionSurfaceCard}" />
        <SolidColorBrush x:Key="MaterialCardBackgroundBrush" Color="{DynamicResource HyperionSurfaceCard}" />
        <SolidColorBrush x:Key="MaterialBackgroundBrush" Color="{DynamicResource HyperionSurfaceBase}" />
        <SolidColorBrush x:Key="MaterialDividerBrush" Color="{DynamicResource HyperionBorder}" />

        <SolidColorBrush x:Key="ValidationErrorBrush" Color="{DynamicResource HyperionDanger}" />
      </Style.Resources>
    </Style>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource HyperionSurfaceBaseBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource HyperionTextHigh}" />
    </Style>
  </Application.Styles>
</Application>
